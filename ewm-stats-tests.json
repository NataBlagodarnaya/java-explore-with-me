    {
      "name": "Получить общую статистику (getStatsAll)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус ответа должен быть 200 OK\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Ответ должен быть массивом\", function () {\n    var jsonData = pm.response.json();\n    pm.expect(jsonData).to.be.an('array');\n    pm.expect(jsonData.length).to.equal(2);\n});\n\npm.test(\"Проверка правильности подсчета просмотров\", function () {\n    var jsonData = pm.response.json();\n    \n    // Первый элемент в массиве (у него 2 просмотра)\n    pm.expect(jsonData[0].uri).to.equal(\"/events/1\");\n    pm.expect(jsonData[0].hits).to.equal(2);\n    \n    // Второй элемент в массиве (у него 1 просмотр)\n    pm.expect(jsonData[1].uri).to.equal(\"/events/2\");\n    pm.expect(jsonData[1].hits).to.equal(1);\n});"
            ]
          }
        }
      ],
